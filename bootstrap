#!/bin/sh

check_and_install() {
	command -v "$1" >/dev/null 2>&1 || {
		if command -v apt-get >/dev/null 2>&1; then
		  if ! command -v sudo >/dev/null 2>&1; then
				apt-get update && apt-get install -y sudo
			fi
			sudo apt-get update && sudo apt-get install -y "$2"
		elif command -v yum >/dev/null 2>&1; then
			sudo yum install -y "$2"
		elif command -v apk >/dev/null 2>&1; then
			sudo apk add --no-cache "$2"
		elif command -v pacman >/dev/null 2>&1; then
			sudo pacman --noconfirm -Sy "$2"
		elif command -v brew >/dev/null 2>&1; then
			brew install "$2"
		else
			echo "Package manager not found. Please install $2 manually." >&2
			return 1
		fi
	}
}

mise_version=v2026.8.11
mise_install_path="$HOME/.local/bin/mise"

# Each step returns its failure rather than exiting: sourced, an exit would
# close the caller's shell. The script's last lines decide.
install_mise() {
	# Ensure curl is installed
	check_and_install curl curl || return 1

	echo "Installing Mise version $mise_version at $mise_install_path..."
	# Fetched whole before it runs: piped into sh, a failed download is an
	# empty script that exits 0, and setup goes on without mise. Both the
	# installer and the archive come from the pinned GitHub release so fan-out
	# CI jobs do not stall on mise.run / mise.jdx.dev connection limits.
	installer=$(curl -fsSL --retry 5 --retry-all-errors "https://github.com/jdx/mise/releases/download/$mise_version/install.sh") || return 1
	printf '%s\n' "$installer" | MISE_INSTALL_PATH=$mise_install_path MISE_VERSION=$mise_version MISE_INSTALL_FROM_GITHUB=1 sh || return 1
	[ -x "$mise_install_path" ] || { echo "the installer left no mise at $mise_install_path" >&2; return 1; }
	echo "Mise installation completed."
}

setup_mise() {
	# Recursively trust all projects in the monorepo by finding mise.toml and running `mise trust` in each directory
	echo "Trusting all projects in the monorepo..."
	# `+`, not `\;`: find reports a failed trust only through the `+` form.
	find . -type f -name ".mise.toml" -execdir "$mise_install_path" trust -a -y {} + || return 1

	echo "Installing default tools..."
	"$mise_install_path" install || return 1

	echo "Mise setup completed."
}

# Detect if the script is being sourced (so we can activate mise in the current shell).
# https://stackoverflow.com/questions/2683279/how-to-detect-if-a-script-is-being-sourced/28776166#28776166
if [ -n "$BASH_VERSION" ]; then
	[ "$0" != "$BASH_SOURCE" ] && sourced=1 || sourced=0
else
	case ${0##*/} in sh|-sh|dash|-dash) sourced=1 ;; *) sourced=0 ;; esac
fi

activate_mise() {
	if [ "$sourced" -eq 1 ]; then
		echo "Activating Mise in the current shell..."
		eval "$("$mise_install_path" activate --shims)"
		echo "Mise is now active in this shell."
	else
		echo "Could not activate Mise because this script was run as a normal command."
		echo "To activate Mise in the current shell, run:"
		echo "    . $0"
		echo "Alternatively, consult 'mise activate --help' for more options."
	fi
}

if [ ! -x "$mise_install_path" ]; then
	echo "Mise not found. Starting installation and setup..."
	if ! { install_mise && setup_mise; }; then
		echo "bootstrap failed" >&2
		[ "$sourced" -eq 1 ] && return 1
		exit 1
	fi
	activate_mise
else
	echo "Mise is already installed at $mise_install_path."
	activate_mise
fi
